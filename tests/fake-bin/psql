#!/bin/bash

commandText=""
commandFromOption=0
schemaHex=""
tableHex=""
connectionHost=""
connectionPort=""

if [ "${PGPASSWORD:-}" != "${TEST_EXPECTED_PASSWORD:-}" ]; then
  echo "unexpected PGPASSWORD" >&2
  exit 1
fi

case " $* " in
  *"${TEST_EXPECTED_PASSWORD:-}"*)
    echo "password leaked into psql arguments" >&2
    exit 1
    ;;
esac

while [ "$#" -gt 0 ]; do
  case "$1" in
    -c)
      commandText="$2"
      commandFromOption=1
      shift 2
      ;;
    -v)
      case "$2" in
        schema_hex=*) schemaHex="${2#schema_hex=}" ;;
        table_hex=*) tableHex="${2#table_hex=}" ;;
      esac
      shift 2
      ;;
    -h)
      connectionHost="$2"
      shift 2
      ;;
    -p)
      connectionPort="$2"
      shift 2
      ;;
    -U|-d|-F)
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

if [ -z "$commandText" ]; then
  commandText="$(cat)"
fi

if [ "$connectionHost" != "${TEST_EXPECTED_HOST:-}" ] || [ "$connectionPort" != "${TEST_EXPECTED_PORT:-}" ]; then
  echo "unexpected host or port" >&2
  exit 1
fi

if [ -z "$commandText" ]; then
  echo "missing psql command" >&2
  exit 1
fi

if [ -n "${TEST_STATE_DIR:-}" ]; then
  printf "%s\n" "$commandText" >> "$TEST_STATE_DIR/calls"
fi

function encodeText() {
  LC_ALL=C od -An -t x1 | tr -d ' \n'
}

function emitRecord() {
  local mappingHex

  mappingHex="$(printf "%s" "$5" | encodeText)" || exit 1
  printf "%s|%s|%s|%s|%s\n" "$1" "$2" "$3" "$4" "$mappingHex"
}

case "$commandText" in
  *pg_catalog.pg_class*)
    case "$commandText" in
      *"c.relkind = 'r'"*"NOT c.relispartition"*) ;;
      *)
        echo "table query does not restrict ordinary non-partition tables" >&2
        exit 1
        ;;
    esac
    case "$TEST_SCENARIO" in
      list-failure)
        echo "unable to connect" >&2
        exit 1
        ;;
      empty)
        exit 0
        ;;
      normalized)
        emitRecord "7075626c6963" "4f726465722d4974656d73" "7075626c69632e224f726465722d4974656d7322" "order-items" '{"directory" : "order-items", "schema" : "public", "table" : "Order-Items"}'
        emitRecord "7075626c6963" "706174682f7461626c65" "7075626c69632e22706174682f7461626c6522" "path-table" '{"directory" : "path-table", "schema" : "public", "table" : "path/table"}'
        emitRecord "7075626c6963" "3130302520646f6e65" "7075626c69632e223130302520646f6e6522" "100%-done" '{"directory" : "100%-done", "schema" : "public", "table" : "100% done"}'
        emitRecord "7075626c6963" "636166c3a9" "7075626c69632e22636166c3a922" "cafe" '{"directory" : "cafe", "schema" : "public", "table" : "café"}'
        ;;
      identifiers)
        emitRecord "7075626c6963" "4f72646572204974656d73" "7075626c69632e224f72646572204974656d7322" "order-items--03000deb" '{"directory" : "order-items--03000deb", "schema" : "public", "table" : "Order Items"}'
        emitRecord "7075626c6963" "4f726465722d4974656d73" "7075626c69632e224f726465722d4974656d7322" "order-items--62b48187" '{"directory" : "order-items--62b48187", "schema" : "public", "table" : "Order-Items"}'
        emitRecord "73616c65732064617461" "706174682f7461626c65" "2273616c65732064617461222e22706174682f7461626c6522" "sales-data.path-table" '{"directory" : "sales-data.path-table", "schema" : "sales data", "table" : "path/table"}'
        emitRecord "7075626c6963" "2e" "7075626c69632e222e22" "table" '{"directory" : "table", "schema" : "public", "table" : "."}'
        emitRecord "7075626c6963" "636166c3a9" "7075626c69632e22636166c3a922" "cafe" '{"directory" : "cafe", "schema" : "public", "table" : "café"}'
        emitRecord "7075626c6963" "3130302520646f6e65" "7075626c69632e223130302520646f6e6522" "100%-done" '{"directory" : "100%-done", "schema" : "public", "table" : "100% done"}'
        emitRecord "7075626c6963" "6c696e650a627265616b" "7075626c69632e226c696e650a627265616b22" "line-break" '{"directory" : "line-break", "schema" : "public", "table" : "line\nbreak"}'
        emitRecord "7075626c6963" "736179226869" "7075626c69632e227361792222686922" "say-hi" '{"directory" : "say-hi", "schema" : "public", "table" : "say\"hi"}'
        ;;
      replacement)
        emitRecord "7075626c6963" "6f7264657273" "7075626c69632e6f7264657273" "orders" '{"directory" : "orders", "schema" : "public", "table" : "orders"}'
        ;;
      concurrency)
        for number in 1 2 3 4 5 6; do
          emitRecord "7075626c6963" "7461626c653$number" "7075626c69632e7461626c653$number" "table$number" "{\"directory\" : \"table$number\", \"schema\" : \"public\", \"table\" : \"table$number\"}"
        done
        ;;
      *)
        emitRecord "7075626c6963" "7573657273" "7075626c69632e7573657273" "users" '{"directory" : "users", "schema" : "public", "table" : "users"}'
        emitRecord "6175646974" "4576656e7473" "61756469742e224576656e747322" "audit.events" '{"directory" : "audit.events", "schema" : "audit", "table" : "Events"}'
        ;;
    esac
    ;;
  *schema_name*table_name*"\\gset"*)
    activeFile=""
    if [ -n "${TEST_STATE_DIR:-}" ]; then
      activeFile="$TEST_STATE_DIR/active/$$"
      : > "$activeFile"
      while ! mkdir "$TEST_STATE_DIR/lock" 2>/dev/null; do
        sleep 0.01
      done
      activeCount="$(find "$TEST_STATE_DIR/active" -type f | wc -l | tr -d ' ')"
      maxActive="$(sed -n '1p' "$TEST_STATE_DIR/max-active")"
      if [ "$activeCount" -gt "$maxActive" ]; then
        printf "%s\n" "$activeCount" > "$TEST_STATE_DIR/max-active"
      fi
      rmdir "$TEST_STATE_DIR/lock"
    fi
    trap '[ -z "$activeFile" ] || find "$activeFile" -delete' EXIT
    [ "$TEST_SCENARIO" != "concurrency" ] || sleep 0.1
    if [ "$TEST_SCENARIO" = "detail-failure" ] && [ "$tableHex" = "7573657273" ]; then
      echo "unable to describe relation" >&2
      exit 1
    fi
    if [ -z "$schemaHex" ] || [ -z "$tableHex" ]; then
      echo "missing encoded detail variables" >&2
      exit 1
    fi
    printf "Table %s.%s\n" "$schemaHex" "$tableHex"
    printf " Column | Type\n"
    printf " column_id | integer\n"
    printf " name | text\n"
    ;;
  *information_schema.columns*)
    if [ "$commandFromOption" -eq 1 ]; then
      echo "psql variables are not expanded in -c SQL" >&2
      exit 1
    fi
    if [ -z "$schemaHex" ] || [ -z "$tableHex" ]; then
      echo "missing encoded metadata variables" >&2
      exit 1
    fi
    printf "column_id\nname\n"
    ;;
  *)
    echo "unexpected psql command: $commandText" >&2
    exit 1
    ;;
esac
