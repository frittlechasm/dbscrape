#!/bin/bash
# A script which parses through a postgres db and gets table information along with per table information

set -o pipefail

function cleanupRunDir() {
  if [ -n "$runDir" ] && [ -d "$runDir" ]; then
    find "$runDir" -depth -delete
  fi
}

function validateOutputTarget() {
  if [ -L /tmp/tables ]; then
    echo "Refusing to replace symbolic link: /tmp/tables" >&2
    return 1
  fi
  if [ -e /tmp/tables ] && { [ ! -d /tmp/tables ] || [ ! -O /tmp/tables ]; }; then
    echo "Refusing to replace unsafe output path: /tmp/tables" >&2
    return 1
  fi
}

function publishSnapshot() {
  local backupRoot
  local previous
  local target="/tmp/tables"

  validateOutputTarget || return 1
  backupRoot="$(mktemp -d /tmp/dbscrape-backup.XXXXXX)" || return 1
  previous="$backupRoot/tables"

  if [ -e "$target" ] && ! mv "$target" "$previous"; then
    find "$backupRoot" -depth -delete
    return 1
  fi

  if mv "$outputRoot" "$target"; then
    [ ! -e "$previous" ] || find "$previous" -depth -delete
    find "$backupRoot" -depth -delete
    return 0
  fi

  [ ! -e "$previous" ] || mv "$previous" "$target"
  find "$backupRoot" -depth -delete
  return 1
}

function waitForJobs() {
  local pid
  local status=0

  for pid in "$@"; do
    wait "$pid" || status=1
  done
  return "$status"
}

function validateHexIdentifier() {
  local value="$1"

  case "$value" in
    ""|*[!0-9a-f]*) return 1 ;;
  esac
  [ $((${#value} % 2)) -eq 0 ]
}

function encodePathComponent() {
  local hex="$1"
  local byte
  local character
  local encoded=""

  while [ -n "$hex" ]; do
    byte="${hex%${hex#??}}"
    hex="${hex#??}"
    case "$byte" in
      20)
        encoded="${encoded}-"
        ;;
      2e|3[0-9]|4[1-9a-f]|5[0-9a]|5f|6[1-9a-f]|7[0-9a])
        printf -v character "%b" "\\x$byte"
        encoded="${encoded}${character}"
        ;;
      *)
        encoded="${encoded}%${byte}"
        ;;
    esac
  done

  case "$encoded" in
    .) encoded="%2e" ;;
    ..) encoded="%2e%2e" ;;
  esac
  printf "%s\n" "$encoded"
}

function appendDecodedHex() {
  local hex="$1"
  local outputFile="$2"
  local byte

  while [ -n "$hex" ]; do
    byte="${hex%${hex#??}}"
    hex="${hex#??}"
    printf "%b" "\\x$byte" >> "$outputFile" || return 1
  done
  printf "\n" >> "$outputFile"
}

function runPsql() {
  local connectionArgs=(-h "$host" -U "$username" -d "$database")

  if [ -n "$port" ]; then
    connectionArgs+=(-p "$port")
  fi
  PGPASSWORD="$password" psql -X -v ON_ERROR_STOP=1 \
    "${connectionArgs[@]}" "$@"
}

function fetchDetails() {
  local schemaHex="$1"
  local tableHex="$2"
  local outputDir="$3"
  local columnsQuery
  local detailsQuery

  detailsQuery="
SELECT pg_catalog.convert_from(pg_catalog.decode(:'schema_hex', 'hex'), 'UTF8') AS schema_name,
       pg_catalog.convert_from(pg_catalog.decode(:'table_hex', 'hex'), 'UTF8') AS table_name
\\gset
\\d :\"schema_name\".:\"table_name\"
"

  columnsQuery="
SELECT column_name
FROM information_schema.columns
WHERE table_schema = pg_catalog.convert_from(pg_catalog.decode(:'schema_hex', 'hex'), 'UTF8')
  AND table_name = pg_catalog.convert_from(pg_catalog.decode(:'table_hex', 'hex'), 'UTF8')
ORDER BY ordinal_position;
"

  mkdir -p -- "$outputDir" \
    && printf "%s\n" "$detailsQuery" \
      | runPsql -v "schema_hex=$schemaHex" -v "table_hex=$tableHex" \
        > "$outputDir/full-details.txt" \
    && printf "%s\n" "$columnsQuery" \
      | runPsql -At -v "schema_hex=$schemaHex" -v "table_hex=$tableHex" \
        > "$outputDir/columns.txt"
}

if [ "$#" -ne 3 ]; then
  echo "Usage: dbscrape <username> <host> <database>" >&2
  exit 1
fi

if ! command -v psql >/dev/null 2>&1; then
  echo "Missing required command: psql" >&2
  exit 1
fi

username="$1"
hostArgument="$2"
database="$3"
runDir=""
port=""

case "$hostArgument" in
  *:)
    echo "Invalid database host or port: $hostArgument" >&2
    exit 1
    ;;
  \[*\]:*)
    host="${hostArgument#\[}"
    host="${host%%\]*}"
    port="${hostArgument##*\]:}"
    ;;
  \[*\])
    host="${hostArgument#\[}"
    host="${host%\]}"
    ;;
  *:*)
    host="${hostArgument%:*}"
    port="${hostArgument##*:}"
    ;;
  *)
    host="$hostArgument"
    ;;
esac
case "$port" in
  *[!0-9]*)
    echo "Invalid database host or port: $hostArgument" >&2
    exit 1
    ;;
esac
if [ -z "$host" ] || { [ -n "$port" ] && { [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; }; }; then
  echo "Invalid database host or port: $hostArgument" >&2
  exit 1
fi

if [ "${PGPASSWORD+x}" = "x" ]; then
  password="$PGPASSWORD"
elif [ -t 0 ]; then
  printf "Password: " >&2
  if ! IFS= read -r -s password; then
    printf "\nUnable to read database password\n" >&2
    exit 1
  fi
  printf "\n" >&2
else
  echo "Password required: set PGPASSWORD or run dbscrape from an interactive terminal" >&2
  exit 1
fi

if ! cd /tmp/ || ! validateOutputTarget; then
  echo "Unable to prepare /tmp/tables" >&2
  exit 1
fi
runDir="$(mktemp -d /tmp/dbscrape.XXXXXX)" || {
  echo "Unable to prepare a temporary output directory" >&2
  exit 1
}
outputRoot="$runDir/tables"
recordsFile="$runDir/table-records"
trap cleanupRunDir EXIT
if ! mkdir "$outputRoot" || ! cd "$outputRoot" || ! : > tables.txt; then
  echo "Unable to prepare staged table output" >&2
  exit 1
fi

tableQuery="
SELECT pg_catalog.encode(pg_catalog.convert_to(n.nspname, 'UTF8'), 'hex'),
       pg_catalog.encode(pg_catalog.convert_to(c.relname, 'UTF8'), 'hex'),
       pg_catalog.encode(
         pg_catalog.convert_to(pg_catalog.format('%I.%I', n.nspname, c.relname), 'UTF8'),
         'hex'
       ),
       CASE
         WHEN n.nspname ~ '^[A-Za-z0-9_]+$' AND c.relname ~ '^[A-Za-z0-9_]+$'
           THEN 'simple'
         ELSE 'encoded'
       END
FROM pg_catalog.pg_class AS c
JOIN pg_catalog.pg_namespace AS n ON n.oid = c.relnamespace
WHERE c.relkind = 'r'
  AND NOT c.relispartition
  AND n.nspname <> 'information_schema'
  AND n.nspname !~ '^pg_'
ORDER BY n.nspname, c.relname;
"

if ! runPsql -At -F '|' -c "$tableQuery" > "$recordsFile"; then
  echo "Unable to list database tables" >&2
  exit 1
fi

pids=()
batchSize=0
maxJobs=5
while IFS='|' read -r schemaHex tableHex relationHex pathMode; do
  if ! validateHexIdentifier "$schemaHex" \
    || ! validateHexIdentifier "$tableHex" \
    || ! validateHexIdentifier "$relationHex"; then
    echo "Database returned an invalid encoded table identifier" >&2
    exit 1
  fi
  case "$pathMode" in
    simple|encoded) ;;
    *)
      echo "Database returned an invalid table path mode" >&2
      exit 1
      ;;
  esac
done < "$recordsFile"

while IFS='|' read -r schemaHex tableHex relationHex pathMode; do
  encodedSchema="$(encodePathComponent "$schemaHex")" || exit 1
  encodedTable="$(encodePathComponent "$tableHex")" || exit 1

  if [ "$pathMode" = "encoded" ]; then
    outputDir=".identifiers/$encodedSchema/$encodedTable"
  elif [ "$encodedSchema" = "public" ]; then
    outputDir="$encodedTable"
  else
    outputDir="$encodedSchema.$encodedTable"
  fi

  appendDecodedHex "$relationHex" tables.txt || exit 1
  fetchDetails "$schemaHex" "$tableHex" "$outputDir" &
  pids+=("$!")
  batchSize=$((batchSize + 1))

  if [ "$batchSize" -eq "$maxJobs" ]; then
    if ! waitForJobs "${pids[@]}"; then
      echo "Database scrape failed" >&2
      exit 1
    fi
    pids=()
    batchSize=0
  fi
done < "$recordsFile"

if ! waitForJobs "${pids[@]}"; then
  echo "Database scrape failed" >&2
  exit 1
fi
if ! publishSnapshot; then
  echo "Unable to replace previous database results" >&2
  exit 1
fi
echo "DB Scraped!!"
