#!/bin/bash
# A script which parses through a postgres db and gets table information along with per table information

# Propagate a failed psql command through pipelines that redirect its output.
set -o pipefail

function cleanupRunDir() {
  if [ -n "$runDir" ] && [ -d "$runDir" ]; then
    find "$runDir" -depth -delete
  fi
}

function validateOutputTarget() {
  if [ -L /tmp/tables ]; then
    echo "Refusing to replace symbolic link: /tmp/tables" >&2
    return 1
  fi
  if [ -e /tmp/tables ] && { [ ! -d /tmp/tables ] || [ ! -O /tmp/tables ]; }; then
    echo "Refusing to replace unsafe output path: /tmp/tables" >&2
    return 1
  fi
}

# Publish only a complete scrape and restore the previous snapshot if the move fails.
function publishSnapshot() {
  local backupRoot
  local previous
  local target="/tmp/tables"

  validateOutputTarget || return 1
  backupRoot="$(mktemp -d /tmp/dbscrape-backup.XXXXXX)" || return 1
  previous="$backupRoot/tables"

  if [ -e "$target" ] && ! mv "$target" "$previous"; then
    find "$backupRoot" -depth -delete
    return 1
  fi

  if mv "$outputRoot" "$target"; then
    [ ! -e "$previous" ] || find "$previous" -depth -delete
    find "$backupRoot" -depth -delete
    return 0
  fi

  [ ! -e "$previous" ] || mv "$previous" "$target"
  find "$backupRoot" -depth -delete
  return 1
}

# Wait for every worker so one failure does not leave sibling jobs running.
function waitForJobs() {
  local pid
  local status=0

  for pid in "$@"; do
    wait "$pid" || status=1
  done
  return "$status"
}

# PostgreSQL returns identifiers as hex so delimiters and path characters stay inert in Bash.
function validateHexIdentifier() {
  local value="$1"

  case "$value" in
    ""|*[!0-9a-f]*) return 1 ;;
  esac
  [ $((${#value} % 2)) -eq 0 ]
}

function appendDecodedHex() {
  local hex="$1"
  local outputFile="$2"
  local byte

  # Consume one encoded byte, represented by two hex characters, per iteration.
  while [ -n "$hex" ]; do
    byte="${hex%${hex#??}}"
    hex="${hex#??}"
    printf "%b" "\\x$byte" >> "$outputFile" || return 1
  done
  printf "\n" >> "$outputFile"
}

function runPsql() {
  local connectionArgs=(-h "$host" -U "$username" -d "$database")

  if [ -n "$port" ]; then
    connectionArgs+=(-p "$port")
  fi
  PGPASSWORD="$password" psql -X -v ON_ERROR_STOP=1 \
    "${connectionArgs[@]}" "$@"
}

function fetchDetails() {
  local schemaHex="$1"
  local tableHex="$2"
  local outputDir="$3"
  local columnsQuery
  local detailsQuery

  # Decode names inside psql, then quote them as identifiers before passing them to \d.
  detailsQuery="
SELECT pg_catalog.convert_from(pg_catalog.decode(:'schema_hex', 'hex'), 'UTF8') AS schema_name,
       pg_catalog.convert_from(pg_catalog.decode(:'table_hex', 'hex'), 'UTF8') AS table_name
\\gset
\\d :\"schema_name\".:\"table_name\"
"

  columnsQuery="
SELECT column_name
FROM information_schema.columns
WHERE table_schema = pg_catalog.convert_from(pg_catalog.decode(:'schema_hex', 'hex'), 'UTF8')
  AND table_name = pg_catalog.convert_from(pg_catalog.decode(:'table_hex', 'hex'), 'UTF8')
ORDER BY ordinal_position;
"

  mkdir -p -- "$outputDir" \
    && printf "%s\n" "$detailsQuery" \
      | runPsql -v "schema_hex=$schemaHex" -v "table_hex=$tableHex" \
        > "$outputDir/full-details.txt" \
    && printf "%s\n" "$columnsQuery" \
      | runPsql -At -v "schema_hex=$schemaHex" -v "table_hex=$tableHex" \
        > "$outputDir/columns.txt"
}

if [ "$#" -ne 3 ]; then
  echo "Usage: dbscrape <username> <host> <database>" >&2
  exit 1
fi

if ! command -v psql >/dev/null 2>&1; then
  echo "Missing required command: psql" >&2
  exit 1
fi

username="$1"
hostArgument="$2"
database="$3"
runDir=""
port=""

case "$hostArgument" in
  *:)
    echo "Invalid database host or port: $hostArgument" >&2
    exit 1
    ;;
  \[*\]:*)
    host="${hostArgument#\[}"
    host="${host%%\]*}"
    port="${hostArgument##*\]:}"
    ;;
  \[*\])
    host="${hostArgument#\[}"
    host="${host%\]}"
    ;;
  *:*)
    host="${hostArgument%:*}"
    port="${hostArgument##*:}"
    ;;
  *)
    host="$hostArgument"
    ;;
esac
case "$port" in
  *[!0-9]*)
    echo "Invalid database host or port: $hostArgument" >&2
    exit 1
    ;;
esac
if [ -z "$host" ] || { [ -n "$port" ] && { [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; }; }; then
  echo "Invalid database host or port: $hostArgument" >&2
  exit 1
fi

if [ "${PGPASSWORD+x}" = "x" ]; then
  password="$PGPASSWORD"
elif [ -t 0 ]; then
  printf "Password: " >&2
  if ! IFS= read -r -s password; then
    printf "\nUnable to read database password\n" >&2
    exit 1
  fi
  printf "\n" >&2
else
  echo "Password required: set PGPASSWORD or run dbscrape from an interactive terminal" >&2
  exit 1
fi

if ! cd /tmp/ || ! validateOutputTarget; then
  echo "Unable to prepare /tmp/tables" >&2
  exit 1
fi
runDir="$(mktemp -d /tmp/dbscrape.XXXXXX)" || {
  echo "Unable to prepare a temporary output directory" >&2
  exit 1
}
outputRoot="$runDir/tables"
recordsFile="$runDir/table-records"
trap cleanupRunDir EXIT
if ! mkdir "$outputRoot" || ! cd "$outputRoot" \
  || ! : > tables.txt || ! : > table-paths.jsonl; then
  echo "Unable to prepare staged table output" >&2
  exit 1
fi

# Find ordinary tables, create readable folder names, resolve collisions, and
# hex-encode identifier text before Bash parses the result.
tableQuery="
WITH ordinary_tables AS (
  SELECT n.nspname AS schema_name, c.relname AS table_name
  FROM pg_catalog.pg_class AS c
  JOIN pg_catalog.pg_namespace AS n ON n.oid = c.relnamespace
  WHERE c.relkind = 'r'
    AND NOT c.relispartition
    AND n.nspname <> 'information_schema'
    AND n.nspname !~ '^pg_'
),
expanded_names AS (
  SELECT schema_name,
         table_name,
         pg_catalog.replace(
           pg_catalog.replace(
             pg_catalog.replace(pg_catalog.lower(schema_name), 'æ', 'ae'),
             'œ', 'oe'
           ),
           'ß', 'ss'
         ) AS expanded_schema,
         pg_catalog.replace(
           pg_catalog.replace(
             pg_catalog.replace(pg_catalog.lower(table_name), 'æ', 'ae'),
             'œ', 'oe'
           ),
           'ß', 'ss'
         ) AS expanded_table
  FROM ordinary_tables
),
folded_names AS (
  SELECT schema_name,
         table_name,
         pg_catalog.translate(
           expanded_schema,
           'áàâäãåāăąçćčďđéèêëēėęěíìîïīįłñńňóòôöõøōőŕřśšşťțúùûüūůűųýÿžźż',
           'aaaaaaaaacccddeeeeeeeeiiiiiilnnnoooooooorrsssttuuuuuuuuyyzzz'
         ) AS folded_schema,
         pg_catalog.translate(
           expanded_table,
           'áàâäãåāăąçćčďđéèêëēėęěíìîïīįłñńňóòôöõøōőŕřśšşťțúùûüūůűųýÿžźż',
           'aaaaaaaaacccddeeeeeeeeiiiiiilnnnoooooooorrsssttuuuuuuuuyyzzz'
         ) AS folded_table
  FROM expanded_names
),
slugs AS (
  SELECT schema_name,
         table_name,
         COALESCE(
           NULLIF(
             pg_catalog.btrim(
               pg_catalog.regexp_replace(folded_schema, '[^a-z0-9%]+', '-', 'g'),
               '-'
             ),
             ''
           ),
           'schema'
         ) AS schema_slug,
         COALESCE(
           NULLIF(
             pg_catalog.btrim(
               pg_catalog.regexp_replace(folded_table, '[^a-z0-9%]+', '-', 'g'),
               '-'
             ),
             ''
           ),
           'table'
         ) AS table_slug
  FROM folded_names
),
base_paths AS (
  SELECT schema_name,
         table_name,
         CASE
           WHEN schema_name = 'public' THEN table_slug
           ELSE schema_slug || '.' || table_slug
         END AS base_path
  FROM slugs
),
named_paths AS (
  SELECT schema_name,
         table_name,
         base_path,
         pg_catalog.count(*) OVER (PARTITION BY base_path) AS path_count,
         pg_catalog.substr(
           pg_catalog.md5(
             pg_catalog.octet_length(schema_name)::text || ':' || schema_name
             || pg_catalog.octet_length(table_name)::text || ':' || table_name
           ),
           1,
           8
         ) AS identity_hash
  FROM base_paths
),
final_paths AS (
  SELECT schema_name,
         table_name,
         CASE
           WHEN path_count > 1 THEN base_path || '--' || identity_hash
           ELSE base_path
         END AS output_dir
  FROM named_paths
)
SELECT pg_catalog.encode(pg_catalog.convert_to(schema_name, 'UTF8'), 'hex'),
       pg_catalog.encode(pg_catalog.convert_to(table_name, 'UTF8'), 'hex'),
       pg_catalog.encode(
         pg_catalog.convert_to(pg_catalog.format('%I.%I', schema_name, table_name), 'UTF8'),
         'hex'
       ),
       output_dir,
       pg_catalog.encode(
         pg_catalog.convert_to(
           pg_catalog.json_build_object(
             'directory', output_dir,
             'schema', schema_name,
             'table', table_name
           )::text,
           'UTF8'
         ),
         'hex'
       )
FROM final_paths
ORDER BY schema_name, table_name;
"

if ! runPsql -At -F '|' -c "$tableQuery" > "$recordsFile"; then
  echo "Unable to list database tables" >&2
  exit 1
fi

pids=()
batchSize=0
maxJobs=5
# IFS='|' makes read split each record on pipes into the five named variables.
# -r keeps backslashes literal instead of treating them as escape characters.
# Validate every record before starting workers to avoid partially written results.
while IFS='|' read -r schemaHex tableHex relationHex outputDir mappingHex; do
  if ! validateHexIdentifier "$schemaHex" \
    || ! validateHexIdentifier "$tableHex" \
    || ! validateHexIdentifier "$relationHex" \
    || ! validateHexIdentifier "$mappingHex"; then
    echo "Database returned an invalid encoded table identifier" >&2
    exit 1
  fi
  case "$outputDir" in
    ""|"."|".."|/*|*/*|*[!a-z0-9.%_-]*)
      echo "Database returned an invalid normalized table path" >&2
      exit 1
      ;;
  esac
done < "$recordsFile"

# Read the validated records again and scrape at most five tables concurrently.
while IFS='|' read -r schemaHex tableHex relationHex outputDir mappingHex; do
  appendDecodedHex "$relationHex" tables.txt || exit 1
  appendDecodedHex "$mappingHex" table-paths.jsonl || exit 1
  fetchDetails "$schemaHex" "$tableHex" "$outputDir" &
  pids+=("$!")
  batchSize=$((batchSize + 1))

  if [ "$batchSize" -eq "$maxJobs" ]; then
    if ! waitForJobs "${pids[@]}"; then
      echo "Database scrape failed" >&2
      exit 1
    fi
    pids=()
    batchSize=0
  fi
done < "$recordsFile"

if ! waitForJobs "${pids[@]}"; then
  echo "Database scrape failed" >&2
  exit 1
fi
if ! publishSnapshot; then
  echo "Unable to replace previous database results" >&2
  exit 1
fi
echo "DB Scraped!!"
