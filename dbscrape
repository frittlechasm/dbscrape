#!/bin/bash
# A script which parses through a postgres db and gets table information along with per table information

set -o pipefail

function cleanupRunDir() {
  if [ -n "$runDir" ] && [ -d "$runDir" ]; then
    find "$runDir" -depth -delete
  fi
}

function validateOutputTarget() {
  if [ -L /tmp/tables ]; then
    echo "Refusing to replace symbolic link: /tmp/tables" >&2
    return 1
  fi
  if [ -e /tmp/tables ] && { [ ! -d /tmp/tables ] || [ ! -O /tmp/tables ]; }; then
    echo "Refusing to replace unsafe output path: /tmp/tables" >&2
    return 1
  fi
}

function publishSnapshot() {
  local backupRoot
  local previous
  local target="/tmp/tables"

  validateOutputTarget || return 1
  backupRoot="$(mktemp -d /tmp/dbscrape-backup.XXXXXX)" || return 1
  previous="$backupRoot/tables"

  if [ -e "$target" ] && ! mv "$target" "$previous"; then
    find "$backupRoot" -depth -delete
    return 1
  fi

  if mv "$outputRoot" "$target"; then
    [ ! -e "$previous" ] || find "$previous" -depth -delete
    find "$backupRoot" -depth -delete
    return 0
  fi

  [ ! -e "$previous" ] || mv "$previous" "$target"
  find "$backupRoot" -depth -delete
  return 1
}

function waitForJobs() {
  local pid
  local status=0

  for pid in "$@"; do
    wait "$pid" || status=1
  done
  return "$status"
}

function runPsql() {
  local connectionArgs=(-h "$host" -U "$username" -d "$database")

  if [ -n "$port" ]; then
    connectionArgs+=(-p "$port")
  fi
  PGPASSWORD="$password" psql -X -v ON_ERROR_STOP=1 \
    "${connectionArgs[@]}" "$@"
}

function fetchDetails() {
  local schema="$1"
  local table="$2"
  local relation="$3"
  local outputDir="$4"
  local columnsQuery

  columnsQuery="
SELECT column_name
FROM information_schema.columns
WHERE table_schema = :'schema'
  AND table_name = :'table'
ORDER BY ordinal_position;
"

  mkdir -p -- "$outputDir" && runPsql -c "\d $relation" \
    | tee -a "$outputDir/full-details.txt" >/dev/null \
    && printf "%s\n" "$columnsQuery" \
      | runPsql -At -v "schema=$schema" -v "table=$table" \
        > "$outputDir/columns.txt"
}

if [ "$#" -ne 4 ]; then
  echo "Usage: dbscrape <username> <password> <host> <database>" >&2
  exit 1
fi

if ! command -v psql >/dev/null 2>&1; then
  echo "Missing required command: psql" >&2
  exit 1
fi

username="$1"
password="$2"
hostArgument="$3"
database="$4"
runDir=""
port=""

case "$hostArgument" in
  *:)
    echo "Invalid database host or port: $hostArgument" >&2
    exit 1
    ;;
  \[*\]:*)
    host="${hostArgument#\[}"
    host="${host%%\]*}"
    port="${hostArgument##*\]:}"
    ;;
  \[*\])
    host="${hostArgument#\[}"
    host="${host%\]}"
    ;;
  *:*)
    host="${hostArgument%:*}"
    port="${hostArgument##*:}"
    ;;
  *)
    host="$hostArgument"
    ;;
esac
case "$port" in
  *[!0-9]*)
    echo "Invalid database host or port: $hostArgument" >&2
    exit 1
    ;;
esac
if [ -z "$host" ] || { [ -n "$port" ] && { [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; }; }; then
  echo "Invalid database host or port: $hostArgument" >&2
  exit 1
fi

if ! cd /tmp/ || ! validateOutputTarget; then
  echo "Unable to prepare /tmp/tables" >&2
  exit 1
fi
runDir="$(mktemp -d /tmp/dbscrape.XXXXXX)" || {
  echo "Unable to prepare a temporary output directory" >&2
  exit 1
}
outputRoot="$runDir/tables"
recordsFile="$runDir/table-records"
trap cleanupRunDir EXIT
if ! mkdir "$outputRoot" || ! cd "$outputRoot" || ! : > tables.txt; then
  echo "Unable to prepare staged table output" >&2
  exit 1
fi

tableQuery="
SELECT schemaname, tablename, format('%I.%I', schemaname, tablename)
FROM pg_catalog.pg_tables
WHERE schemaname NOT IN ('pg_catalog', 'information_schema')
ORDER BY schemaname, tablename;
"

if ! runPsql -At -F '|' -c "$tableQuery" > "$recordsFile"; then
  echo "Unable to list database tables" >&2
  exit 1
fi

pids=()
batchSize=0
maxJobs=5
while IFS='|' read -r schema table relation; do
  case "$schema" in
    ""|*[!A-Za-z0-9_]*)
      echo "Unsupported schema name for output: $schema" >&2
      exit 1
      ;;
  esac
  case "$table" in
    ""|*[!A-Za-z0-9_]*)
      echo "Unsupported table name for output: $table" >&2
      exit 1
      ;;
  esac

  if [ "$schema" = "public" ]; then
    outputDir="$table"
  else
    outputDir="$schema.$table"
  fi

  printf "%s\n" "$relation" | tee -a tables.txt >/dev/null
  fetchDetails "$schema" "$table" "$relation" "$outputDir" &
  pids+=("$!")
  batchSize=$((batchSize + 1))

  if [ "$batchSize" -eq "$maxJobs" ]; then
    if ! waitForJobs "${pids[@]}"; then
      echo "Database scrape failed" >&2
      exit 1
    fi
    pids=()
    batchSize=0
  fi
done < "$recordsFile"

if ! waitForJobs "${pids[@]}"; then
  echo "Database scrape failed" >&2
  exit 1
fi
if ! publishSnapshot; then
  echo "Unable to replace previous database results" >&2
  exit 1
fi
echo "DB Scraped!!"
